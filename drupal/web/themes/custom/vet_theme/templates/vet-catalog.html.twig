<section class="catalog-header" aria-labelledby="catalog-title"><div><a class="breadcrumb-link" href="{{ path('<front>') }}">Inicio</a><span class="breadcrumb-separator">/</span><span class="breadcrumb-current">Tienda</span><span class="eyebrow catalog-eyebrow">SU BIENESTAR, TAMBIÉN EN CASA</span><h1 id="catalog-title">Todo para tu<br /><em>mejor compañía.</em></h1><p>Alimentos, accesorios y cuidado. Encuentra ese pequeño detalle que hace feliz su día.</p></div><div class="catalog-header-note">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'paw'} only %}<span>Para sus paseos,<br />sus juegos y sus<br /><strong>momentos contigo.</strong></span></div></section>
{% if business.catalog_is_example %}<div class="catalog-demo-notice"><span class="demo-indicator"></span><p><strong>Catálogo de demostración.</strong> Productos, precios y existencias de ejemplo. Las imágenes son ilustraciones referenciales.</p></div>{% endif %}
<div class="catalog-layout">
  <aside class="catalog-sidebar" aria-label="Filtros del catálogo">
    <form class="catalog-filters" method="get" action="{{ path('vet_api.catalog') }}">
      <h2>Encuentra lo que necesita</h2>
      <label for="catalog-query">Buscar producto</label><div class="search-input"><input id="catalog-query" type="search" name="q" value="{{ filters.q }}" placeholder="Nombre o SKU…" maxlength="100" /><span aria-hidden="true">⌕</span></div>
      <label for="catalog-category">Categoría</label><select id="catalog-category" name="category"><option value="">Todas las categorías</option>{% for id, label in categories %}<option value="{{ id }}"{% if filters.category == id %} selected{% endif %}>{{ label }}</option>{% endfor %}</select>
      <label for="catalog-species">¿Para quién?</label><select id="catalog-species" name="species"><option value="">Todas las mascotas</option>{% for id, label in species_options %}<option value="{{ id }}"{% if filters.species == id %} selected{% endif %}>{{ label }}</option>{% endfor %}</select>
      <button class="button" type="submit">Aplicar filtros <span aria-hidden="true">↗</span></button>
      {% if filters.q or filters.category or filters.species %}<a class="clear-filters" href="{{ path('vet_api.catalog') }}">Limpiar filtros</a>{% endif %}
    </form>
    <div class="catalog-help">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'heart'} only %}<h3>¿Necesitas una mano?</h3><p>Conversemos sobre lo que buscas para tu mascota.</p><a href="{{ business.whatsapp_url }}" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp ↗</a></div>
  </aside>
  <section class="catalog-results" aria-labelledby="results-title">
    <div class="catalog-results-heading"><h2 id="results-title">{% if filters.q %}Resultados de “{{ filters.q }}”{% else %}Hecho para ellos{% endif %}</h2><p><strong>{{ total }}</strong> {{ total == 1 ? 'producto' : 'productos' }}{% if total > 12 %} · {{ products|length }} en esta página{% endif %}</p></div>
    {% if products %}<div class="product-grid">{% for item in products %}
      <article class="product-card" data-sku="{{ item.sku }}"><a class="product-image-link" href="{{ item.url }}" aria-label="Ver {{ item.name }}"><div class="product-image"><img src="{{ item.image_url }}" alt="{{ item.image_alt }}" width="720" height="660" loading="lazy" />{% if not item.available %}<span class="product-status is-sold-out">Agotado</span>{% endif %}</div></a><div class="product-card-body"><span class="product-category">{{ item.category }}</span><h3><a href="{{ item.url }}">{{ item.name }}</a></h3><p class="product-species">{% for label in item.species %}{{ label }}{{ not loop.last ? ' · ' : '' }}{% endfor %}</p><div class="product-price-row"><strong>{{ item.price }}</strong><span class="stock-label{{ not item.available ? ' stock-label-empty' : '' }}">{{ item.available ? item.stock ~ ' disponibles' : 'Sin existencias' }}</span></div><a class="product-detail-link" href="{{ item.url }}">Ver producto <span aria-hidden="true">↗</span></a></div></article>
    {% endfor %}</div><div class="catalog-pager">{{ pager }}</div>{% else %}<div class="catalog-empty">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'bag'} only %}<h3>No encontramos coincidencias.</h3><p>Prueba con otro nombre o categoría. También puedes preguntarnos por WhatsApp.</p><a class="button" href="{{ path('vet_api.catalog') }}">Ver todos los productos</a></div>{% endif %}
  </section>
</div>
