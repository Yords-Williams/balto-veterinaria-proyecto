{% set assets = vet_assets %}
<section class="hero hero-carousel" data-hero-carousel role="region" aria-roledescription="carrusel" aria-label="Destacados de BALTO Veterinaria">
  <div class="hero-slides">
  <div class="container hero-grid hero-slide" data-hero-slide role="group" aria-roledescription="diapositiva" aria-label="1 de 3: Medicina para tu mascota" aria-hidden="false">
    <div class="hero-copy">
      <span class="eyebrow"><span class="small-line"></span> CON ELLOS, EN CADA ETAPA</span>
      <h1 id="hero-title">{% if business.slogan == 'Medicina para tu mascota' %}Medicina para<br />tu <em>mascota.</em>{% else %}{{ business.slogan }}{% endif %}<span class="heading-paw" aria-hidden="true">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'paw'} only %}</span></h1>
      <p class="hero-description">Son parte de tu familia. Su salud también es parte de la nuestra. En {{ business.name }}, estamos cerca para cuidarlos.</p>
      <div class="hero-actions"><a class="button" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'whatsapp'} only %} Separa tu cita por WhatsApp {% include '@vet_theme/templates/icon.html.twig' with {icon: 'arrow-up-right'} only %}</a><a class="text-link" href="#servicios">Conoce nuestros servicios <span aria-hidden="true">↘</span></a></div>
      <div class="hero-note"><span class="note-icon">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'heart'} only %}</span><p>Para sus días felices.<br /><strong>Y para cuando más te necesitan.</strong></p></div>
    </div>
    <div class="hero-visual">
      <span class="hero-orbit" aria-hidden="true"></span>
      <div class="hero-image{% if clinic_gallery.portada %} hero-image-clinic{% endif %}">{% if clinic_gallery.portada %}<img src="{{ clinic_gallery.portada.image_url }}" width="{{ clinic_gallery.portada.width }}" height="{{ clinic_gallery.portada.height }}" alt="{{ clinic_gallery.portada.alt }}" fetchpriority="high" />{% else %}<img src="{{ assets }}/images/companeros.jpg" width="1500" height="1001" alt="Dos perros paseando juntos al aire libre" fetchpriority="high" />{% endif %}</div>
      <div class="care-badge"><span class="care-badge-icon">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'cross'} only %}</span><span><strong>Hospitalización {{ business.hospitalization }}</strong><small>Su cuidado no se detiene.</small></span></div>
      <div class="hero-tag">{% if clinic_gallery.portada %}Una mirada. Todo nuestro compromiso.{% else %}Un vínculo que merece cuidado{% endif %} <span aria-hidden="true">✳</span></div>
    </div>
  </div>
    {% include '@vet_theme/templates/hero-slides.html.twig' %}
  </div>
  <div class="container carousel-controls" data-carousel-controls hidden>
    <div class="carousel-navigation"><button class="carousel-arrow" type="button" data-carousel-prev aria-label="Diapositiva anterior">←</button><div class="carousel-dots" role="group" aria-label="Elegir diapositiva"><button type="button" data-carousel-dot="0" aria-label="Ver presentación de BALTO" aria-current="true"></button><button type="button" data-carousel-dot="1" aria-label="Ver hospitalización 24 horas"></button><button type="button" data-carousel-dot="2" aria-label="Ver tienda para mascotas"></button></div><button class="carousel-arrow" type="button" data-carousel-next aria-label="Siguiente diapositiva">→</button></div>
    <button class="carousel-pause" type="button" data-carousel-pause aria-label="Pausar carrusel">Ⅱ <span>Pausar</span></button>
    <span class="visually-hidden" data-carousel-status aria-live="polite" aria-atomic="true"></span>
  </div>
</section>

<div class="care-strip"><div class="container care-strip-inner"><span>{% include '@vet_theme/templates/icon.html.twig' with {icon: 'heart'} only %} Cuidamos lo que más quieres</span><span>{% include '@vet_theme/templates/icon.html.twig' with {icon: 'pin'} only %} Cerca de ti, en Juliaca</span><a href="#horarios">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'moon'} only %} Hospitalización {{ business.hospitalization }}</a></div></div>

<section id="servicios" class="section services-section" aria-labelledby="services-title">
  <div class="container">
    <div class="section-heading"><div><span class="eyebrow">SU BIENESTAR, PRIMERO</span><h2 id="services-title">Cuidado en cada<br /><em>etapa de su vida.</em></h2></div><p>Desde su consulta hasta su recuperación.<br />Conoce cómo podemos acompañarlos.</p></div>
    <div class="services-grid">
      {% for service in services %}
        <a class="service-card{% if service.icon == 'moon' %} service-card-featured{% endif %}" href="{{ service.url }}"><span class="service-icon">{% include '@vet_theme/templates/icon.html.twig' with {icon: service.icon} only %}</span><span class="service-number">{{ '%02d'|format(loop.index) }}</span><h3>{{ service.title }}</h3><p>{{ service.description }}</p><span class="service-more">Conoce el servicio <span aria-hidden="true">↗</span></span></a>
      {% else %}<p class="empty-state">Estamos actualizando nuestros servicios. Escríbenos por WhatsApp para orientarte.</p>{% endfor %}
    </div>
  </div>
</section>

<section id="nosotros" class="about-section" aria-labelledby="about-title">
  <div class="container about-grid">
    {% if clinic_gallery.nosotros %}
      <figure class="about-photo">
        <img src="{{ clinic_gallery.nosotros.image_url }}" width="{{ clinic_gallery.nosotros.width }}" height="{{ clinic_gallery.nosotros.height }}" alt="{{ clinic_gallery.nosotros.alt }}" loading="lazy" decoding="async" />
        <figcaption><span class="photo-caption-mark" aria-hidden="true">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'paw'} only %}</span><span>{{ clinic_gallery.nosotros.caption }}</span></figcaption>
      </figure>
    {% else %}
      <div class="about-mark" aria-hidden="true"><span>BALTO</span>{% include '@vet_theme/templates/icon.html.twig' with {icon: 'paw'} only %}<small>MEDICINA PARA TU MASCOTA</small></div>
    {% endif %}
    <div class="about-copy"><span class="eyebrow">HOLA, SOMOS BALTO</span><h2 id="about-title">{{ business.about_title }}</h2><p>{{ business.about_text }}</p>{% if clinic_gallery.nosotros %}<div class="about-commitment"><span aria-hidden="true">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'heart'} only %}</span><p><strong>{{ clinic_gallery.nosotros.title }}</strong><span>Cercanía en la atención. Compromiso con cada paciente.</span></p></div>{% endif %}<a class="text-link" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">Conversemos sobre tu mascota <span aria-hidden="true">↗</span></a></div>
  </div>
</section>

{% if clinic_gallery.stories %}
<section id="historias" class="section stories-section" aria-labelledby="stories-title">
  <div class="container">
    <div class="section-heading"><div><span class="eyebrow">MOMENTOS DE NUESTRA VETERINARIA</span><h2 id="stories-title">Historias que<br /><em>nos acompañan.</em></h2></div><p>Pequeños pacientes, grandes historias.<br />Momentos compartidos por BALTO a lo largo del tiempo.</p></div>
    <div class="stories-grid">
      {% for story in clinic_gallery.stories %}
        <article class="story-card">
          <a class="story-photo story-photo-{{ loop.index }}" href="{{ story.original_url }}" target="_blank" rel="noopener noreferrer" aria-label="Ver fotografía completa: {{ story.title }}"><img src="{{ story.image_url }}" width="{{ story.width }}" height="{{ story.height }}" alt="{{ story.alt }}" loading="lazy" decoding="async" /><span class="story-photo-open" aria-hidden="true">↗</span></a>
          <div class="story-copy"><span class="story-kicker">ARCHIVO DE BALTO <span aria-hidden="true">·</span> {{ '%02d'|format(loop.index) }}</span><h3>{{ story.title }}</h3><p>{{ story.caption }}</p></div>
        </article>
      {% endfor %}
    </div>
    <div class="stories-footer"><p>Cada paciente tiene su propia historia y recibe una evaluación individual.</p><a class="text-link" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">Conoce cómo podemos ayudarte ↗</a></div>
  </div>
</section>
{% endif %}

<section class="section shop-intro" aria-labelledby="shop-title"><div class="container shop-banner"><div><span class="eyebrow">TAMBIÉN EN SU DÍA A DÍA</span><h2 id="shop-title">Pequeños detalles.<br /><em>Grandes colitas felices.</em></h2><p>Alimentos, accesorios y cuidado para acompañar su bienestar.</p>{% if business.catalog_is_example %}<span class="example-note">Catálogo de demostración · Productos y precios de ejemplo</span>{% endif %}</div><div class="shop-illustration" aria-hidden="true">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'bag'} only %}<span>para tu<br /><em>mejor amigo.</em></span></div><a class="button button-light" href="{{ path('vet_api.catalog') }}">Conoce la tienda {% include '@vet_theme/templates/icon.html.twig' with {icon: 'arrow-up-right'} only %}</a></div></section>

<section id="ubicacion" class="section location-section" aria-labelledby="location-title"><div class="container"><div class="section-heading"><div><span class="eyebrow">SIEMPRE CERCA</span><h2 id="location-title">Nos vemos<br /><em>en Juliaca.</em></h2></div><p>Dos sedes para encontrarnos.<br />Una misma razón: su bienestar.</p></div><div class="location-grid"><div class="locations-info">{% for address in business.addresses %}<article class="address-row"><span class="address-number">0{{ loop.index }}</span><div><h3>{{ loop.first ? 'Sede central' : 'Segunda sede' }}</h3><p>{{ address }}</p>{% if loop.first %}<a class="text-link" href="{{ business.maps_link }}" target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>{% endif %}</div></article>{% endfor %}<div id="horarios" class="schedule-panel"><h3>{% include '@vet_theme/templates/icon.html.twig' with {icon: 'clock'} only %} Nuestros horarios</h3><div class="schedule-hospital"><span>Hospitalización</span><strong>{{ business.hospitalization }}</strong></div><div class="consultation-hours"><strong>Tienda y consultorio</strong>{% if business.schedule_is_example %}<span class="example-label">Horario de ejemplo · Por confirmar</span>{% endif %}<p>{{ business.consultation_schedule }}</p></div><a href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">Confirma tu visita por WhatsApp ↗</a></div></div><div class="map-wrap"><iframe title="Mapa de la sede central de BALTO Veterinaria en Juliaca" src="{{ business.map_url }}" width="640" height="560" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><div class="map-caption">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'pin'} only %} BALTO · Sede central</div></div></div></div></section>

<section id="contacto" class="contact-section"><div class="container contact-inner"><div><span class="eyebrow">EL PRIMER PASO ES CONVERSAR</span><h2>Estamos para ti.<br /><em>Y para tu mascota.</em></h2><p>Separa tu cita o consulta por nuestros servicios.</p></div><a class="button button-yellow" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'whatsapp'} only %} Escríbenos al {{ business.whatsapp }} {% include '@vet_theme/templates/icon.html.twig' with {icon: 'arrow-up-right'} only %}</a></div></section>
