{# Los horarios y las imágenes de pacientes provienen de Drupal. #}
<div class="container hero-grid hero-slide hero-slide-care" data-hero-slide role="group" aria-roledescription="diapositiva" aria-label="2 de 3: Hospitalización" aria-hidden="true" inert>
  <div class="hero-copy"><span class="eyebrow"><span class="small-line"></span> A SU LADO, CUANDO MÁS LO NECESITA</span><h2 class="carousel-title">Su cuidado continúa,<br /><em>las {{ business.hospitalization }}.</em></h2><p class="hero-description">Acompañamos a nuestros pacientes durante su hospitalización. Conoce nuestros servicios y consulta con el equipo de {{ business.name }}.</p><div class="hero-actions"><a class="button" href="#servicios">Conocer nuestros servicios {% include '@vet_theme/templates/icon.html.twig' with {icon: 'arrow-up-right'} only %}</a><a class="text-link" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">Consultar por WhatsApp ↗</a></div><p class="carousel-footnote">Tienda y consultorio: {{ business.consultation_schedule }}{% if business.schedule_is_example %} (horario de ejemplo){% endif %}.</p></div>
  <div class="carousel-care-visual clinic-scenes-panel"><div class="clinic-scenes">
    <figure class="clinic-scene-main"><svg viewBox="1159 139 201 192" role="img" aria-label="Atención de un paciente en BALTO"><image href="{{ vet_assets }}/images/balto-clinic-banner.png" width="1600" height="607" /></svg><figcaption>Atención cercana</figcaption></figure>
    <figure><svg viewBox="1376 65 137 134" role="img" aria-label="Equipos de laboratorio mostrados por BALTO"><image href="{{ vet_assets }}/images/balto-clinic-banner.png" width="1600" height="607" /></svg><figcaption>Laboratorio</figcaption></figure>
    <figure><svg viewBox="1146 385 128 123" role="img" aria-label="Equipo de diagnóstico por imagen mostrado por BALTO"><image href="{{ vet_assets }}/images/balto-clinic-banner.png" width="1600" height="607" /></svg><figcaption>Diagnóstico por imagen</figcaption></figure>
  </div><p class="clinic-scenes-source">Imágenes compartidas por BALTO Veterinaria.</p><span class="carousel-care-seal">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'cross'} only %} Hospitalización {{ business.hospitalization }}</span></div>
</div>
<div class="container hero-grid hero-slide hero-slide-shop" data-hero-slide role="group" aria-roledescription="diapositiva" aria-label="3 de 3: Tienda para mascotas" aria-hidden="true" inert>
  <div class="hero-copy"><span class="eyebrow"><span class="small-line"></span> PEQUEÑOS DETALLES, GRANDES COLITAS FELICES</span><h2 class="carousel-title">Todo para consentir<br /><em>a tu compañero.</em></h2><p class="hero-description">Alimentos, accesorios, higiene y juguetes. Encuentra su próximo favorito en la tienda de BALTO, con precios en soles.</p><div class="hero-actions"><a class="button" href="{{ path('vet_api.catalog') }}">Explorar la tienda {% include '@vet_theme/templates/icon.html.twig' with {icon: 'arrow-up-right'} only %}</a></div>{% if business.catalog_is_example %}<p class="carousel-footnote">Catálogo y precios de ejemplo, pendientes del inventario real.</p>{% endif %}</div>
  <div class="carousel-shop-visual"><div class="carousel-shop-disc" aria-hidden="true"></div><img src="{{ vet_assets }}/images/carousel-petshop.svg" width="600" height="460" alt="Ilustración de una bolsa de alimento, un plato y una pelota para mascotas" loading="lazy" /><div class="carousel-category-tags"><span>Alimentos</span><span>Accesorios</span><span>Juguetes</span></div></div>
</div>
