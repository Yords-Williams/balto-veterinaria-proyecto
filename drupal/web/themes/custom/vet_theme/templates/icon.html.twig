{# Conjunto propio coherente de iconos lineales. El SVG es decorativo. #}
<svg class="icon icon-{{ icon }}" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if icon == 'arrow-up-right' %}<path d="M6 18 18 6M6 6h12v12" />
{% elseif icon == 'pin' %}<path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.4"/>
{% elseif icon == 'heart' %}<path d="M20.8 5.9a5 5 0 0 0-7.1 0L12 7.6l-1.7-1.7a5 5 0 0 0-7.1 7.1L12 21l8.8-8a5 5 0 0 0 0-7.1Z"/>
{% elseif icon == 'bag' %}<path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/><path d="m9 14 2 2 4-4"/>
{% elseif icon == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{% elseif icon == 'menu' %}<path d="M4 6h16M4 12h16M4 18h16"/>
{% elseif icon == 'cross' %}<path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6Z"/>
{% elseif icon == 'whatsapp' %}<path d="M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.5-4.6A9 9 0 1 1 21 11.5Z"/><path d="M8 7c0 5 4 9 9 9l1-3-3-1-1 2a9 9 0 0 1-4-4l2-1-1-3-3 1Z"/>
{% elseif icon == 'paw' %}<ellipse cx="7" cy="7" rx="2" ry="3" transform="rotate(-20 7 7)"/><ellipse cx="15" cy="5" rx="2" ry="3" transform="rotate(10 15 5)"/><ellipse cx="21" cy="10" rx="1.7" ry="2.5" transform="rotate(30 21 10)"/><ellipse cx="2.9" cy="13" rx="1.7" ry="2.5" transform="rotate(-25 2.9 13)"/><path d="M7 15c2-2 3-6 6-5s3 4 5 6c4 6-3 6-6 4-4 2-9 1-5-5Z"/>
{% elseif icon == 'stethoscope' %}<path d="M4 3v6a5 5 0 0 0 10 0V3M3 3h3m6 0h3M9 14v3a4 4 0 0 0 8 0v-3"/><circle cx="17" cy="11" r="3"/>
{% elseif icon == 'xray' %}<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M12 6v12M8 8l4 2 4-2M8 12l4 2 4-2M8 16l4 2 4-2"/>
{% elseif icon == 'ultrasound' %}<rect x="3" y="3" width="18" height="14" rx="2"/><path d="M8 21h8m-4-4v4M6 10h3l2-4 3 8 2-4h2"/>
{% elseif icon == 'surgery' %}<path d="m4 20 7-7m1-9 8 8M9 11l6-6 4 4-6 6Z"/><path d="m7 7 2 2M5 9l2 2M15 17l2 2m0-4 2 2"/>
{% elseif icon == 'lab' %}<path d="M9 3h6m-5 0v7L4 19c-1 1 0 2 2 2h12c2 0 3-1 2-2l-6-9V3M7 15h10"/><circle cx="12" cy="17" r=".5"/>
{% elseif icon == 'bed' %}<path d="M3 7v14m18-9v9M3 17h18M3 12h18v5M5 8h4v4H5Z"/><path d="M11 9h7a3 3 0 0 1 3 3"/>
{% elseif icon == 'moon' %}<path d="M20.8 13.3A9 9 0 0 1 10.7 3.2 9 9 0 1 0 20.8 13.3Z"/><path d="M18 3v4m-2-2h4"/>
{% else %}<path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6Z"/>{% endif %}
</svg>
