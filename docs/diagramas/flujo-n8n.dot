digraph n8n {
  graph [rankdir=LR, bgcolor="white", pad=.15, nodesep=.28, ranksep=.30, dpi=170, pack=12, packmode="array_uc1"];
  node [shape=box, style="rounded,filled", fillcolor="#EFF6F0", color="#45745C", fontname="DejaVu Sans", fontsize=11, margin=".12,.09"];
  edge [color="#407058", arrowsize=.7];
  subgraph cluster_bot {
    label="3. Bot privado"; sortv=1; labeljust=l; fontname="DejaVu Sans"; color="#B7CFC0";
    button [label="Comando o botón\nen Telegram"];
    owner [label="n8n verifica el\nchat autorizado"];
    action [label="Drupal consulta datos\no registra el pago"];
    reply [label="Resultado en\nTelegram"];
    button -> owner -> action -> reply;
  }
  subgraph cluster_orders {
    label="2. Pedidos y stock bajo"; sortv=2; labeljust=l; fontname="DejaVu Sans"; color="#B7CFC0";
    order [label="Evento de Drupal\no revisión diaria"];
    review [label="n8n prepara aviso\no revisa existencias"];
    alert [label="Aviso al dueño\nen Telegram"];
    order -> review -> alert;
  }
  subgraph cluster_chat {
    label="1. Chatbot web"; sortv=3; labeljust=l; fontname="DejaVu Sans"; color="#B7CFC0";
    chat [label="Pregunta en BALTO"];
    classify [label="n8n clasifica con reglas\nGemini si hace falta"];
    api [label="Consulta Drupal\nsegún la pregunta"];
    answer [label="Respuesta en\nel chat web"];
    chat -> classify -> api -> answer;
  }
}
